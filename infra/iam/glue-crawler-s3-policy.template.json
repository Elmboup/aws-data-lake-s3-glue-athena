{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDataLakePrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/transactions",
            "raw/transactions/*",
            "silver/transactions",
            "silver/transactions/*",
            "quarantine/transactions",
            "quarantine/transactions/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadCataloguedObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/raw/transactions/*",
        "arn:aws:s3:::BUCKET_NAME/silver/transactions/*",
        "arn:aws:s3:::BUCKET_NAME/quarantine/transactions/*"
      ]
    }
  ]
}
