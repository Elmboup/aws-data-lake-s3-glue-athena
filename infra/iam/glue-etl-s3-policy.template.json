{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListETLPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/transactions",
            "raw/transactions/*",
            "silver/transactions",
            "silver/transactions/*",
            "quarantine/transactions",
            "quarantine/transactions/*",
            "scripts/glue",
            "scripts/glue/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadRawAndScripts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/raw/transactions/*",
        "arn:aws:s3:::BUCKET_NAME/scripts/glue/*"
      ]
    },
    {
      "Sid": "WriteSilverAndQuarantine",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/silver/transactions/*",
        "arn:aws:s3:::BUCKET_NAME/quarantine/transactions/*"
      ]
    }
  ]
}
